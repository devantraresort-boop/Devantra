# Local development. Never commit your populated .env.
ENVIRONMENT=development
RESORT_TIMEZONE=Asia/Kolkata
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Set true for a serverless host with an external connection pooler (e.g. Neon).
DATABASE_NULL_POOL=false
# Single process: memory://. Multiple processes/replicas: shared redis:// or rediss://.
RATE_LIMIT_STORAGE_URI=memory://
MAX_REQUEST_BYTES=65536
# Optional scheduler credential for POST /api/internal/maintenance.
MAINTENANCE_SECRET=
EMAIL_MAX_ATTEMPTS=8
# Docker Compose only: generate a URL-safe password, e.g. secrets.token_hex(32).
POSTGRES_PASSWORD=
# Copy this file to .env and replace the placeholders before starting the API.
DATABASE_URL=sqlite:///./devantara.db
# Optional direct PostgreSQL URL for migrations; runtime traffic uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:8765","http://127.0.0.1:8765","http://localhost:5500","http://127.0.0.1:5500"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
BOOKING_HOLD_MINUTES=15
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true
# Use the HTTP email API on Render Free; SMTP ports are blocked there.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RESORT_NAME=Devantara Resort
RESORT_PHONE=
RESORT_ADDRESS=
ADMIN_CONTACT_EMAIL=
